/target

# Build artifact staged by `just stage` under the entrypoint name `backend.toml`
# declares. A local, installable copy of the binary — never committed; the
# release workflow builds its own from source.
/super-stt-backend-qwen

# Coverage artifacts (cargo-llvm-cov). `just coverage-lcov` writes lcov.info to
# the repo root; the HTML report lives under target/. Profiles can land in CWD.
/lcov.info
*.profraw
*.profdata

# The parity script's bytecode.
__pycache__/

.claude/worktrees/
.claude/scheduled_tasks.lock

# What the Python backend's coverage runs left behind, before the port.
/.coverage
/coverage.json
/htmlcov/
